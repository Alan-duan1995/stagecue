{
  "name": "stagecue-client",
  "version": "3.0.1",
  "description": "StageCue 本地演出音乐与音效客户端",
  "author": "中东中亚IT SSC   Alan",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare:app": "node prepare.cjs",
    "start": "node prepare.cjs && electron .",
    "dist:win": "node prepare.cjs && node build-win.cjs",
    "dist:mac": "node prepare.cjs && node build-mac.cjs"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "^0.27.4"
  },
  "build": {
    "appId": "com.itssc.stagecue",
    "productName": "StageCue",
    "copyright": "中东中亚IT SSC   Alan",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*",
      "assets/icon.png",
      "package.json",
      "services/**/*",
      "app/THIRD-PARTY-NOTICES.txt"
    ],
    "directories": {
      "output": "../build/client"
    },
    "artifactName": "StageCue-Setup-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StageCue",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "2052",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "afterPack": "./after-pack.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "StageCue-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.music",
      "icon": "assets/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "StageCue 仅在你选择音频路由时请求音频设备权限，用于识别主声卡和耳机输出，不保存录音。"
      }
    },
    "dmg": {
      "title": "StageCue ${version}",
      "contents": [
        {
          "x": 145,
          "y": 160,
          "type": "file"
        },
        {
          "x": 430,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alan-duan1995/stagecue.git"
  },
  "dependencies": {
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "chokidar": "^6.0.0",
    "music-metadata": "^12.5.0",
    "taglib-wasm": "^2.4.1",
    "ws": "^8.23.0"
  }
}
