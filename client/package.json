{
  "name": "stagecue-client",
  "version": "2.1.0",
  "description": "StageCue 本地演出音乐与音效客户端",
  "author": "中东中亚IT SSC   Alan",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare:app": "node prepare.cjs",
    "start": "node prepare.cjs && electron .",
    "dist:win": "node prepare.cjs && node build-win.cjs"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.itssc.stagecue",
    "productName": "StageCue",
    "copyright": "中东中亚IT SSC   Alan",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "../build/client"
    },
    "artifactName": "StageCue-Setup-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StageCue",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "2052",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "afterPack": "./after-pack.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alan-duan1995/stagecue.git"
  }
}
